# Local Docker development settings. Copy this file to .env and replace the
# secret before exposing the service outside your machine.
POSTGRES_DB=securetask
POSTGRES_USER=securetask_user
POSTGRES_PASSWORD=change-me
SECURETASK_DATABASE_URL=postgresql+psycopg://securetask_user:change-me@db:5432/securetask
SECURETASK_SECRET_KEY=replace-with-a-long-random-secret
SECURETASK_ALGORITHM=HS256
SECURETASK_ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURETASK_REFRESH_TOKEN_EXPIRE_DAYS=7
SECURETASK_METRICS_TOKEN=replace-with-a-separate-random-secret
SECURETASK_AUTH_RATE_LIMIT_REQUESTS=10
SECURETASK_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SECURETASK_ENVIRONMENT=development
SECURETASK_DEBUG=false
SECURETASK_LOG_LEVEL=INFO
SECURETASK_CORS_ORIGINS=[]
SECURETASK_DB_POOL_SIZE=5
SECURETASK_DB_MAX_OVERFLOW=10
